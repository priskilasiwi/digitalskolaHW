      "name": "Post Bank account data request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Test Response Body\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.status).to.eql(\"COMPLETED\");\r",
              "    pm.expect(jsonData.reference_id).to.eql(\"testingsiniaja\");\r",
              "    pm.expect(jsonData.bank_account_number).to.eql(\"170101007\");\r",
              "    pm.expect(jsonData.created).not.null\r",
              "});\r",
              "\r",
              "pm.test(\"Test field is not empty\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.not.be.empty;\r",
              "});"
